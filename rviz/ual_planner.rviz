Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Image
      Enabled: true
      Image Topic: /projected_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Projected Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /sam3/annotated_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Segmentation Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Alpha: 0.5
      Cell Size: 0.25
      Class: rviz/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Reference Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /landing/markers
      Name: Landing Evaluation
      Namespaces:
        airspace_occupied: true
        landing_boundary: true
        landing_plane: true
        landing_status: true
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: -1
      Name: Current View
      Pitch: 0.65
      Target Frame: base_link
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
