Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.22
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 75; 85; 95
      Color Transformer: Intensity
      Decay Time: 0.5
      Enabled: true
      Invert Rainbow: true
      Max Intensity: 255
      Min Intensity: 0
      Name: Livox PointCloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.01
      Style: Points
      Topic: /livox/lidar
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.5
      Cell Size: 0.25
      Class: rviz/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Reference Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /landing/markers
      Name: Landing Evaluation
      Namespaces:
        airspace_occupied: true
        landing_boundary: true
        landing_plane: true
        landing_status: true
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 14
      Focal Point:
        X: 1.24
        Y: 1.08
        Z: -1.12
      Name: Current View
      Pitch: 0.96
      Target Frame: <Fixed Frame>
      Yaw: 0.94
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
