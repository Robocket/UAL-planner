<launch>
  <arg name="use_rviz" default="true" />
  <arg name="use_ground_truth_attitude" default="true" />
  <param name="use_sim_time" value="true" />
  <rosparam command="load" file="$(find landing_evaluator)/config/hil_sim.yaml" />
  <node pkg="landing_evaluator" type="landing_evaluator_node"
        name="landing_evaluator" output="screen" />
  <node if="$(arg use_ground_truth_attitude)" pkg="landing_evaluator"
        type="odom_gravity_adapter.py" name="landing_odom_gravity_adapter" output="screen" />
  <include file="$(find landing_evaluator)/launch/landing_visualization.launch">
    <arg name="use_rviz" value="$(arg use_rviz)" />
    <arg name="pointcloud_topic" value="/livox/avia/points" />
  </include>
</launch>
