<launch>
  <arg name="visualize" default="true" />
  <arg name="use_rviz" default="true" />
  <rosparam command="load" file="$(find landing_evaluator)/config/d1_test.yaml" />
  <node pkg="landing_evaluator" type="landing_evaluator_node"
        name="landing_evaluator" output="screen" />
  <include if="$(arg visualize)" file="$(find landing_evaluator)/launch/landing_visualization.launch">
    <arg name="use_rviz" value="$(arg use_rviz)" />
    <arg name="pointcloud_topic" value="/iv_points" />
    <arg name="sensor_frame" value="d1_frame" />
  </include>
</launch>
